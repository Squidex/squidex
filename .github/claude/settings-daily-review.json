{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(gh pr list:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)"
    ]
  }
}
