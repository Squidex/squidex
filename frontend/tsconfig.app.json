{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/app",
        "types": ["ace"]
    },
    "files": ["src/main.ts"],
    "include": ["**/*.stories.*", "src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"],
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "nullishCoalescingNotNullable": "suppress",
                "optionalChainNotNullable": "suppress"
            }
        }
    }
}
